## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/
*.code-workspace

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# T4 generated files
*.generated.cs

# Backup & report files
*_i.c
*_p.c
*_h.h
*.tmp
*.tmp_proj
*.log
*.vspscc
*.vssscc
*.pidb
*.svclog
*.scc

# NuGet
*.nupkg
*.snupkg
# The packages folder can be ignored because of Package Restore
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# Microsoft Azure Web App publish settings
PublishProfiles/

# Others
*.dbmdl
*.bak
*.backup
*.BLOB
*.pdb
*.cache
*.config
*.jfm
*.pfx
*.publishsettings
*.pubxml
*.publishproj
*.dll
*.exe

# Rider
.idea/

# Mac
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Test results
TestResult*
*.trx
*.coverage
*.coveragexml

# User secrets
secrets.json
